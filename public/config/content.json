    {
      "id": "intro-panel",
      "enabled": true,
      "size": [2.3, 1.15],
      "position": [-2.35, 1.7, 5.925],
      "rotation": [0, 3.1415926536, 0],
      "backgroundColor": "#ffffff",
      "textColor": "#111111",
      "borderColor": "#111111",
      "borderWidth": 12,
      "canvasWidth": 1600,
      "canvasHeight": 800,
      "heading": "BLANK ROOM",
      "body": "This is an experiment in making testimony enterable rather than simply readable. The room is a configurable framework rather than a finished virtual gallery. Images, text, objects and sound can be placed within it, but the space itself can also be skinned: walls, floors, architectural planes and objects can carry images and textures. The room therefore doesn't have to remain a neutral container for testimony. It can become an immersive environment made from the testimony itself. Its architecture can also be altered to suit the material. Routes can be created, obstructed or left open, allowing someone to travel one way outbound and another on their return. There need not be a single prescribed route through the material. A visitor might double back, miss something entirely, encounter fragments in a different order, or find a different configuration on a subsequent visit. Their movement through the space becomes part of the interpretation, producing one possible reading rather than a definitive one. The current version uses fixed navigation, but mouse-controlled exploration can also be enabled. Sound can be located within the space — voices, environmental audio or fragments of testimony — so that moving towards, away from or past something can change what is heard as well as what is seen. The intention is not simply to reproduce a physical exhibition online, but to explore what becomes possible when testimony can occupy and shape a navigable space, and the person encountering it has to find their own way through.",
      "padding": 150,
      "headingSize": 76,
      "bodySize": 34,
      "lineHeight": 1.4,
      "fontFamily": "Helvetica Neue, Helvetica, Arial, sans-serif"
    }
